# Trello API Credentials (from https://trello.com/app-key)
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_TOKEN=your_trello_api_token_here
TRELLO_WEBHOOK_SECRET=your_webhook_secret_here

# Bot Member ID (ID of the Trello account associated with the token, used to ignore self-triggered webhooks)
BOT_MEMBER_ID=your_bot_member_id_here

# Target Sync Configuration (Board IDs)
SOURCE_BOARD_ID=your_source_board_id_here
TARGET_BOARD_ID=your_target_board_id_here

# AWS & DynamoDB Configuration (automatically populated in Lambda, customizable for local dev)
AWS_REGION=us-east-1
SYNC_TABLE_NAME=trello-sync-store-dev
SYNC_QUEUE_URL=http://localhost:9324/000000000000/trello-sync-queue-dev
